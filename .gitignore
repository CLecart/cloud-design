# Terraform: local state (it holds resource details), provider cache and the
# per-machine variables (admin IP). The lock file and *.tfvars.example are committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
*.tfplan

# Local evidence of test runs (logs with the account ID and the admin IP)
preuves/

# AWS access keys downloaded from the IAM console
*accessKeys*.csv
*credentials*.csv

# Secret manifests generated by Scripts/generate-secrets.sh: only the
# *.yaml.example templates are committed, never the real credentials.
Manifests/secrets/*.yaml

# Node.js (the images install their own dependencies)
node_modules/
npm-debug.log*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*~
