# Credentials of the inventory PostgreSQL database.
# Read by inventory-db (POSTGRES_USER, POSTGRES_PASSWORD) and by inventory-app
# (DB_USER, DB_PASSWORD).
#
# Template: Scripts/generate-secrets.sh copies it to inventory-db-secret.yaml
# (ignored by Git) and replaces every CHANGE_ME_* value by a random secret.
apiVersion: v1
kind: Secret
metadata:
  name: inventory-db-secret
  labels:
    app: inventory-db
    app.kubernetes.io/part-of: orchestrator
type: Opaque
stringData:
  username: inventory_user
  password: CHANGE_ME_INVENTORY_DB_PASSWORD
