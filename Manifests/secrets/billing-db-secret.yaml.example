# Credentials of the billing PostgreSQL database.
# Read by billing-db (POSTGRES_USER, POSTGRES_PASSWORD) and by billing-app
# (DB_USER, DB_PASSWORD).
#
# Template: Scripts/generate-secrets.sh copies it to billing-db-secret.yaml
# (ignored by Git) and replaces every CHANGE_ME_* value by a random secret.
apiVersion: v1
kind: Secret
metadata:
  name: billing-db-secret
  labels:
    app: billing-db
    app.kubernetes.io/part-of: orchestrator
type: Opaque
stringData:
  username: billing_user
  password: CHANGE_ME_BILLING_DB_PASSWORD
