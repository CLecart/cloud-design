# Credentials of the RabbitMQ broker.
# Read by rabbitmq (RABBITMQ_DEFAULT_USER, RABBITMQ_DEFAULT_PASS), by
# api-gateway (publisher) and by billing-app (consumer) as RABBITMQ_USER and
# RABBITMQ_PASSWORD.
#
# Template: Scripts/generate-secrets.sh copies it to rabbitmq-secret.yaml
# (ignored by Git) and replaces every CHANGE_ME_* value by a random secret.
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secret
  labels:
    app: rabbitmq
    app.kubernetes.io/part-of: orchestrator
type: Opaque
stringData:
  username: rabbit_user
  password: CHANGE_ME_RABBITMQ_PASSWORD
